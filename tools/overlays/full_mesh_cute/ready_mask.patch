+    @cute.jit
+    def _next_ready_block(
+        self,
+        phase_flags: cute.Tensor,
+        epoch: Int32,
+        slot_thresh,
+        n_block_min: Int32,
+        n_block_max: Int32,
+        pending_mask: Int32,
+        active_next: Int32,
+        active_min: Int32,
+        tidx: Int32,
+    ):
+        if active_next <= active_min:
+            chosen = Int32(-1)
+            chosen_min = Int32(0)
+            chosen_max = Int32(0)
+            # Prefer a segment whose payload is already visible. Reverse
+            # probing preserves the old high-to-low traversal as a tie-break.
+            for probe in cutlass.range_constexpr(self.streaming_slots):
+                slot = self.streaming_slots - 1 - probe
+                slot_min = cutlass.max(slot_thresh[slot], n_block_min)
+                slot_max = (
+                    cutlass.min(slot_thresh[slot + 1], n_block_max)
+                    if const_expr(slot + 1 < self.streaming_slots)
+                    else n_block_max
+                )
+                observed = Int32(0)
+                if tidx % 32 == 0:
+                    observed = _ld_acquire_sys(phase_flags.iterator + slot)
+                observed = cute.arch.shuffle_sync(observed, 0)
+                ready = observed == epoch
+                if (
+                    chosen < 0
+                    and (pending_mask & (Int32(1) << slot)) != 0
+                    and slot_min < slot_max
+                    and ready
+                ):
+                    chosen = Int32(slot)
+                    chosen_min = slot_min
+                    chosen_max = slot_max
+
+            # Nothing was ready at the instant of the scan. Block on the
+            # highest pending segment, then continue without a global barrier.
+            if chosen < 0:
+                for probe in cutlass.range_constexpr(self.streaming_slots):
+                    slot = self.streaming_slots - 1 - probe
+                    slot_min = cutlass.max(slot_thresh[slot], n_block_min)
+                    slot_max = (
+                        cutlass.min(slot_thresh[slot + 1], n_block_max)
+                        if const_expr(slot + 1 < self.streaming_slots)
+                        else n_block_max
+                    )
+                    if (
+                        chosen < 0
+                        and (pending_mask & (Int32(1) << slot)) != 0
+                        and slot_min < slot_max
+                    ):
+                        if tidx % 32 == 0:
+                            _wait_eq_sys(
+                                phase_flags.iterator,
+                                Int32(0),
+                                slot,
+                                epoch,
+                            )
+                        cute.arch.sync_warp()
+                        chosen = Int32(slot)
+                        chosen_min = slot_min
+                        chosen_max = slot_max
+
+            pending_mask = pending_mask & ~(Int32(1) << chosen)
+            active_min = chosen_min
+            active_next = chosen_max
+
+        n_block = active_next - 1
+        active_next -= 1
+        return n_block, pending_mask, active_next, active_min
